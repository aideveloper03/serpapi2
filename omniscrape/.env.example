# OmniScrape Engine Configuration
# ================================

# Application Settings
APP_NAME=OmniScrape Engine
APP_VERSION=1.0.0
APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO

# Server Configuration
HOST=0.0.0.0
PORT=8000
WORKERS=4

# Concurrency Limits
MAX_CONCURRENT_SERP_SCRAPES=60
MAX_CONCURRENT_DEEP_SCRAPES=30
REQUEST_TIMEOUT=30
CONNECT_TIMEOUT=10

# Redis Configuration
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=
CACHE_TTL=3600
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Proxy Configuration
PROXY_LIST_URL=https://raw.githubusercontent.com/TheSpeedX/SOCKS-List/master/http.txt
PROXY_VALIDATION_TIMEOUT=5
PROXY_POOL_SIZE=50
CUSTOM_PROXY_URL=
PROXY_ROTATION_INTERVAL=30

# Browser Settings
HEADLESS_MODE=true
BROWSER_TIMEOUT=30000
MAX_BROWSER_INSTANCES=5
STEALTH_MODE=true

# Crawler Settings
MAX_CRAWL_DEPTH=3
MAX_PAGES_PER_CRAWL=100
CRAWL_DELAY_MIN=1.0
CRAWL_DELAY_MAX=3.0
RESPECT_ROBOTS_TXT=false

# Retry Configuration
MAX_RETRIES=3
RETRY_DELAY=1.0
RETRY_BACKOFF_MULTIPLIER=2.0

# CAPTCHA Settings
CAPTCHA_SOLVE_TIMEOUT=60
ENABLE_LOCAL_CAPTCHA_SOLVER=true
OCR_ENGINE=tesseract

# Anti-Detection Settings
ROTATE_USER_AGENT=true
ROTATE_FINGERPRINT=true
SPOOF_HEADERS=true
TLS_FINGERPRINT_CHROME=true

# Search Engine Specific
GOOGLE_DELAY=2.0
BING_DELAY=1.0
DUCKDUCKGO_DELAY=0.5
YAHOO_DELAY=1.5
YANDEX_DELAY=2.0

# Data Mining Settings
EXTRACT_EMAILS=true
EXTRACT_PHONES=true
EXTRACT_SOCIAL_LINKS=true
EXTRACT_SCHEMA_ORG=true
